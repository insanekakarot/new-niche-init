APP_NAME=new-niche-overall
DEBUG=false
PORT=1023
# Required for /admin. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
SCRIPTS_CONFIG_DIR=/mnt/z/new-niche-overall/admin/configs/_scripts

# ---- Generation CLIs (app/cli/config.py) ----
# Provider preselected in the Scripting page's "Generate with" dropdown: claude | codex
CLI_DEFAULT_PROVIDER=claude
# Effort per step type, for every brand (new brands use it automatically), Claude and Codex.
# step:level pairs; levels: low | medium | high | xhigh | max | ultra (Codex only; Claude gets max).
# A step not listed here uses CLAUDE_CLI_EFFORT / CODEX_CLI_REASONING_EFFORT.
CLI_STEP_EFFORTS=research:high,outline:high,script:medium,audits:high,paraphrasing:high
# Where step results are saved (default: app/output)
# CLI_OUTPUT_DIR=/home/penguinDev/new-niche-overall/app/output

# ---- Claude CLI ----
# Path to the CLI. From WSL with a Windows install: /mnt/c/Users/<you>/.local/bin/claude.exe
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_MODEL=claude-sonnet-5
# Default for steps not in CLI_STEP_EFFORTS: low | medium | high | xhigh | max
CLAUDE_CLI_EFFORT=medium
# Comma-separated backup models if the main one is unavailable (empty = none)
CLAUDE_CLI_FALLBACK_MODEL=
# Tools Claude may use while writing ("" = none). Web tools let it check facts.
CLAUDE_CLI_TOOLS=WebSearch,WebFetch
CLAUDE_CLI_TIMEOUT_SECONDS=1200
# Spending cap per run in USD (0 = no cap)
CLAUDE_CLI_MAX_BUDGET_USD=0
CLAUDE_CLI_MAX_CONCURRENT_RUNS=2
CLAUDE_CLI_SAFE_MODE=true
CLAUDE_CLI_NO_SESSION_PERSISTENCE=true
# Extra CLI flags, e.g. --verbose
CLAUDE_CLI_EXTRA_ARGS=
# Override the built-in system prompt (see app/cli/config.py) if needed:
# CLAUDE_CLI_SYSTEM_PROMPT=

# ---- Codex CLI ----
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=gpt-5.6-sol
# Default for steps not in CLI_STEP_EFFORTS: low | medium | high | xhigh | max | ultra
CODEX_CLI_REASONING_EFFORT=medium
# live | cached | disabled
CODEX_CLI_WEB_SEARCH=live
# read-only | workspace-write (Codex runs in an empty temp folder either way)
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_TIMEOUT_SECONDS=1200
CODEX_CLI_MAX_CONCURRENT_RUNS=2
# Skip ~/.codex/config.toml and execpolicy rules (login still comes from ~/.codex)
CODEX_CLI_IGNORE_USER_CONFIG=true
CODEX_CLI_IGNORE_RULES=true
CODEX_CLI_EPHEMERAL=true
CODEX_CLI_EXTRA_ARGS=
# Override the built-in instructions placed at the top of every Codex prompt:
# CODEX_CLI_SYSTEM_PROMPT=
